{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CertificateForCloudFront",
      "Effect": "Allow",
      "Action": ["acm:RequestCertificate", "acm:DescribeCertificate", "acm:ListCertificates", "acm:AddTagsToCertificate"],
      "Resource": "*"
    },
    {
      "Sid": "DnsRecords",
      "Effect": "Allow",
      "Action": ["route53:ListHostedZones", "route53:ListHostedZonesByName", "route53:ListResourceRecordSets", "route53:ChangeResourceRecordSets", "route53:GetChange", "route53:GetHostedZone"],
      "Resource": "*"
    }
  ]
}
